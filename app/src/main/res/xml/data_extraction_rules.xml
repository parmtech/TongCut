<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Private projects are not automatically copied via Android cloud backup. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
